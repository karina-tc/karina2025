---
// Components
import Layout from "../layouts/Layout.astro";
import AtomSymbol from "../components/elements/AtomSymbol.astro";
import Header from "../components/structure/Header.astro";
import GridContainer from "../components/structure/GridContainer.astro";
import SectionContainer from "../components/structure/SectionContainer.astro";
import Details from "../components/elements/Details.astro";
import Showcase from "../components/structure/Showcase.astro";
import TestimonialCard from "../components/elements/TestimonialCard.astro";
import SubSection from "../components/structure/SubSection.astro";

// Assets
import { Image } from "astro:assets";
import colbg from "../assets/illustrations/thoughts-dark.png";
// Data
import { projects } from "../data/projects";
import { testimonials } from "../data/testimonials";
---

<Layout pageTitle="Karina Tovar">
  <SectionContainer
    include_classes="max-w-screen-base-md mx-auto h-[80vh] flex flex-col justify-center items-center"
  >
    <div
      class="flex justify-center items-center absolute inset-0 animate-slow-fade-in"
    >
      <Image
        src={colbg}
        alt="Thoughts Background"
        class="theme-image m-auto max-w-[300px] sm:max-w-[400px] lg:max-w-[500px] opacity-50 xl:opacity-90"
        width={600}
        height={600}
        id="themeImage"
      />
    </div>
    <AtomSymbol include_classes="w-20 h-20 mt-10" />
    <Header
      title="Pixel Philosopher, Cautious Technologist"
      subtitle="Hi, friend. My name is Karina and I am a product designer and coder who loves to build products that aim to make people's lives happier."
    />
  </SectionContainer>

  <SectionContainer
    include_classes="my-20 bg-theme-surface-dark text-white max-xl:px-20 !-ml-20 min-w-[100vw]"
  >
    <GridContainer spacing="md" include_classes="[&>p]:text-2xl max-w-3xl pb-0">
      <h2>What I Believe</h2>
      <p class="copy-extra-large">
        Life is too short to put poorly thought-out products out into the world.
      </p>
      <p>
        For most of us in tech, our products are used by hundreds of people, if
        not more. So why give them something that doesn't work?
      </p>
      <p>
        Customers are paying you to make sure they can get their job done. So
        your company's success should be enshrined in the success and happiness
        of your customers.
      </p>
      <p>
        Today, with all the tools available to our disposal, we have no excuse
        to not reach validation faster and iterate quickly on the solutions that
        can be life changing for our customers. Every customer&mdash;regardless
        of your product's category&mdash;is in pain. You must give them a
        solution that changes their life for the better. That in turn makes your
        product worth it. That in turn makes your product worth it.
      </p>
      <p>
        The future of design is not one just in pushing pretty pixels, but in
        delivering actual value to customers. That value is in their happiness
        and that hapiness will be rewarded in your product's financial success.
      </p>
    </GridContainer>

    <GridContainer include_classes="pt-0">
      <h2>What I Can Do</h2>
      <div class="skills-container [&>details]:-mb-[9px]">
        <Details
          html_data={{ open: true }}
          summary_text="Full-stack product builder"
        >
          I've helped startup companies of all sizes build products from the
          ground up. Focusing on strategy, design and dabbling in front-end
          development.
        </Details>
        <Details summary_text="Bring polish to your product">
          While I cannot claim to be a master of design, I can help you bring
          delight and the right brand aesthetics to your product. All while
          keeping your product's functionality in mind and building long-lasting
          systems.
        </Details>
        <Details summary_text="Build for now and later">
          I will help you attain focused, right-sized versions of your product
          as I also help you imagine what your product can be based on customer
          feedback and market signals.
        </Details>
      </div>
    </GridContainer>
  </SectionContainer>

  <SectionContainer include_classes="max-w-screen-base-md mx-auto">
    <SubSection
      label="Work"
      title="Most recent projects"
      show_link={true}
      link_label="See All Work"
      link_hover_label="View Case Studies"
      link_href="/work"
    />

    <section class="showcase-container">
      {projects.map((project) => <Showcase {...project} />)}
    </section>
  </SectionContainer>

  <SectionContainer include_classes="max-w-screen-base-md mx-auto my-20">
    <SubSection
      label="Testimonials"
      title="What people say"
      show_link={true}
      link_label="See More"
      link_hover_label="View in Linkedin"
      link_href="/testimonials"
    />

    <div class="testimonials-container">
      {testimonials.map((testimonial) => <TestimonialCard {...testimonial} />)}
    </div>
  </SectionContainer>
</Layout>

<style>
  .showcase-container {
    @apply w-full overflow-x-scroll py-10 h-fit flex flex-col gap-4 scroll-smooth mb-10;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    scroll-snap-type: x mandatory;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    scroll-padding: 1rem;
  }

  .skills-container {
    @apply flex flex-col gap-2 pb-28;
  }

  .testimonials-container {
    @apply grid grid-cols-[repeat(auto-fill,minmax(400px,1fr))] gap-10 pt-10 max-w-screen-base-md mx-auto;
  }
</style>
