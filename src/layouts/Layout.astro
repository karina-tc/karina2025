---
// Global Styles
import '../styles/global.css';

// Components
import CommonHead from "../components/structure/CommonHead.astro";
import StickyNav from "../components/elements/StickyNav.astro";
import Footer from "../components/structure/Footer.astro";

interface Props {
  pageTitle?: string;
  pageDescription?: string;
}

const {
  pageTitle = "Karina Tovar",
  pageDescription = "Pixel Philosopher Cautious Technologist",
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <CommonHead {pageTitle} {pageDescription} />

  <body>
    <div class="root">
      <main class="main">
        <StickyNav />
        <div class="content">
          <slot />
        </div>
      </main>
      <div class="p-20"></div>
      <Footer />
    </div>
  </body>
</html>
