---
interface SocialLink {
  name: string;
  url: string;
}

interface FooterColumn {
  title: string;
  links: Array<{ text: string; url?: string; isEmail?: boolean }>;
}

// Configuration
const year = new Date().getFullYear();

const socialLinks: SocialLink[] = [
  { name: "Github", url: "https://github.com/karina-tc" },
  { name: "LinkedIn", url: "https://www.linkedin.com/in/karina-tovar-castro/" },
  { name: "Threads", url: "https://threads.net/karinatovar" },
];

const footerColumns: FooterColumn[] = [
  {
    title: "Get in Touch",
    links: [
      { text: "Email me", isEmail: true },
      { text: "Book me", url: "https://cal.com/karina-tovar-djofxs/quick-chat?month=2025-01&date=2025-01-28" }
    ]
  },
  {
    title: "Everywhere Else",
    links: socialLinks.map(({ name, url }) => ({ text: name, url }))
  }
];

const colophonData = {
  image: "https://media1.giphy.com/media/v1.Y2lkPTc5MGI3NjExZmRhaTNnN2RoNzZ0YW5pa255cXZpcHVuYXFxODgzMnlzMzdkajRodiZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/3oKIPnAiaMCws8nOsE/giphy.webp",
  links: [
    { text: "AstroJs", url: "https://astro.build" },
    { text: "Safiro", url: "https://www.atipofoundry.com/fonts/safiro" }
  ]
};
---

<footer class="footer">
  <div class="layout--two-columns footer-links relative z-base">
    <div class="layout--two-columns__left footer-links--column">
      <div class="flex items-center gap-2">
        <span>&copy; {year} Karina Tovar · </span>
        <button class="colophon-button" popovertarget="colophonPopover">
          Colophon
        </button>
      </div>
      <div id="colophonPopover" popover="auto" class="colophon-popover">
        <img
          src={colophonData.image}
          alt="coding"
          class="w-full mb-4"
          draggable="false"
        />
        <p>
          This website was coded with love, sweat, and tears using 
          {colophonData.links.map(({ text, url }, index) => (
            <>
              <a href={url} class="underline" target="_blank">{text}</a>
              {index === 0 && ", TypeScript, and Tailwind CSS. I'm using "}
              {index === 1 && " as a font."}
            </>
          ))}
        </p>
      </div>
    </div>
    
    <div class="layout--two-columns__right footer-links--column-right">
      {footerColumns.map(({ title, links }) => (
        <div class="footer-links--column">
          <span class="footer-links--title">{title}</span>
          <div class="footer-links--text">
            {links.map(({ text, url, isEmail }) => 
              isEmail ? (
                <button
                  class="copy-email-btn group"
                  data-email="hello@karinatovar.com"
                  onclick="copyEmail(this)"
                >
                  <span class="copy-email-btn--text">{text}</span>
                  <span class="copy-email-btn--message">Copied address!</span>
                </button>
              ) : (
                <a href={url} target="_blank">{text}</a>
              )
            )}
          </div>
        </div>
      ))}
    </div>
  </div>
</footer>

<script is:inline>
  function copyEmail(button) {
    var email = button.dataset.email;
    navigator.clipboard.writeText(email).then(function () {
      button.classList.add("copied");

      setTimeout(function () {
        button.classList.remove("copied");
      }, 3000);
    });
  }
</script>

<style>
  /* Base footer layout */
  .footer {
    @apply w-full flex flex-col justify-center items-center gap-10 relative z-base py-20 px-10;
    @apply overflow-hidden bg-theme-surface-light;
  }

  /* Common column styles */
  .footer-links--column {
    @apply flex flex-col gap-2 h-full items-start justify-start max-xl:order-2;
  }

  .footer-links--column-right {
    @apply flex flex-col xl:flex-row gap-6 h-full items-start justify-start;
    @apply [&>div]:flex-1 max-xl:order-1 max-xl:-mt-5 max-xl:pb-6;
  }

  /* Text styles */
  .footer-links--title {
    @apply text-sm font-medium opacity-70 uppercase tracking-widest;
  }

  .footer-links--text {
    @apply text-xl;

    & > * {
      @apply block mb-2;
    }

    & > a {
      @apply underline-offset-4 decoration-dotted decoration-neutral-400 transition-all duration-300 hover:underline;
    }
  }

  /* Add these new styles */
  .colophon-button {
    @apply bg-theme-paper px-2 py-1 rounded-md transition-all duration-300 hover:underline underline-offset-4;
  }

  .colophon-popover {
    @apply bg-white p-4 rounded-lg shadow-lg max-w-xs text-sm;
    @apply border border-theme-stroke;
  }

  .colophon-popover p {
    @apply mb-2 last:mb-0;
  }

  .copy-email-btn {
    @apply !flex items-center justify-between h-6 gap-2 mb-2;

    &.copied .copy-email-btn--message {
      @apply opacity-70 translate-x-0;
    }
  }

  .copy-email-btn--text {
    @apply inline-block underline-offset-4 decoration-dotted decoration-neutral-400 group-hover:underline transition-all duration-300;
  }

  .copy-email-btn--message {
    @apply inline-block pt-1 opacity-0 text-xs font-semibold tracking-widest uppercase font-mono;
    @apply -translate-x-20 transition-all duration-300;
  }
</style>
