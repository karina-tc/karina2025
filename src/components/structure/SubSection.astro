---
import LinkButton from "../elements/LinkButton.astro";

interface Props {
  label: string;
  title: string;
  show_link: boolean;
  link_label: string;
  link_hover_label: string;
  link_href: string;
  link_html_attributes?: Record<string, string>;
}

const {
  label = "Label",
  title = "Title",
  show_link,
  link_label,
  link_hover_label,
  link_href,
  link_html_attributes = {},
} = Astro.props;
---

<div class="flex flex-col gap-4">
  <div class="top-container">
    <div class="cross-border" aria-hidden="true">
      <div class="mark"></div>
    </div>
    <div class="top-label">
      <span>{label}</span>
    </div>
  </div>

  <div class="bottom-container">
    <h2 class="my-0">{title}</h2>
    {show_link && (
      <LinkButton
        href={link_href}
        label={link_label}
        hover_label={link_hover_label}
        {...link_html_attributes}
      />
    )}
  </div>
</div>

<style>
  .top-container {
    @apply relative w-1/3;
  }

  .cross-border {
    @apply absolute inset-0 flex items-center;

    .mark {
      @apply w-full border-t border-theme-stroke;
    }
  }

  .top-label {
    @apply relative flex justify-start;

    span {
      @apply bg-theme-paper pr-2 text-sm font-medium;
    }
  }

  .bottom-container {
    @apply flex lg:flex-row flex-col justify-between lg:items-center;
    @apply items-start lg:gap-4 gap-10 w-full pt-10 pb-5;
  }
</style>
