<div class="screen-frame">
  <div class="loader-logo">
    <svg
      width="520"
      height="520"
      viewBox="0 0 520 520"
      fill="#b099f8"
      class="loader-logo-stroke animate-sequence"
      xmlns="http://www.w3.org/2000/svg"
    >
      <path
        d="M134.66 15.1387C47.9158 2.32967 35.2461 98.198 23.4286 178.109C-21.4652 481.683 56.3273 506.028 108.132 509.803C177.997 514.893 184.632 420.306 233.631 369.2C300.73 299.217 467.361 488.239 505.851 369.2C536.443 274.59 389.025 290.591 352.804 240.102C316.583 189.613 456.961 182.712 469.63 121.868C478.285 80.3039 455.838 35.8758 416.064 15.1387C340.052 -24.4913 278.525 178.109 233.631 178.109C188.737 178.109 251.041 32.3238 134.66 15.1387Z"
        stroke="#031B1A"
        stroke-width="20"
      >
      </path>
    </svg>
  </div>
</div>

<style>
  .screen-frame {
    @apply w-screen h-screen p-20;
    @apply bg-theme-highlight-lilac;
    @apply flex items-center justify-center;
    @apply fixed top-0 left-0 z-50 !overflow-hidden;
    animation: disappear 2s cubic-bezier(0.4, 0, 0.2, 1) forwards 2.5s;
  }

  .loader-logo {
    @apply m-auto rotate-[15deg];
  }

  .loader-logo-stroke {
    @apply max-w-[50vw] xl:max-w-[25vw];
  }

  .animate-sequence {
    stroke-dasharray: 100000;
    stroke-dashoffset: 100000;
    scale: 0;
    animation:
      scaleIn 1s cubic-bezier(0.4, 0, 0.2, 1) forwards,
      drawPath 1.5s cubic-bezier(0.4, 0, 0.2, 1) forwards 0.5s,
      expand 2s cubic-bezier(0.4, 0, 0.2, 1) forwards 1.5s;
  }

  @keyframes scaleIn {
    from {
      scale: 0;
      opacity: 0;
    }
    to {
      scale: 1;
      opacity: 1;
    }
  }

  @keyframes drawPath {
    to {
      stroke-dashoffset: 0;
    }
  }

  @keyframes expand {
    0% {
      scale: 1;
      fill: #b099f8;
    }
    50% {
      scale: 1;
      fill: #031b1a;
    }
    100% {
      scale: 15;
      fill: #031b1a;
    }
  }

  @keyframes disappear {
    to {
      transform: translateY(-100%);
      visibility: hidden;
    }
  }
</style>
