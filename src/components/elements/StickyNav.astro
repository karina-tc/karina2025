---
import Logo from "./Logo.astro";
const { pathname } = Astro.url;

const navItems = [
  { href: "/", label: "Intro", paths: ["/"] },
  { href: "/about", label: "About", paths: ["/about"] },
  { href: "/work", label: "Work", paths: ["/work"] },
  { href: "/thoughts", label: "Thoughts", paths: ["/thoughts", "/notebooks"] }
];

const isActive = (paths: string[]) => {
  if (paths.includes("/")) {
    return pathname === "/";
  }
  return paths.some(path => pathname.startsWith(path));
};
---

<nav class="nav">
  <div class="nav-container">
    <a href="/" class="nav-home">
      <Logo classes="w-10 h-10" />
      <span class="nav-home-text animate-fade-in"> Karina Tovar</span>
    </a>
    <div class="nav-links">
      {
        navItems.map(({ href, label, paths }) => (
          <a href={href} class={isActive(paths) ? "active" : ""}>
            {label}
          </a>
        ))
      }
    </div>
  </div>
  <div class="nav-fade"></div>
</nav>

<style>
  .nav {
    @apply w-[calc(100%+2rem)] flex flex-col justify-between items-center sticky top-0 z-navigation;
  }

  .nav-container {
    @apply flex items-center justify-between w-full flex-wrap space-y-10 bg-paper-base pt-10 pb-2 px-4;
  }

  .nav-home {
    @apply font-medium flex items-center justify-center;
  }

  .nav-home-text {
    @apply text-2xl font-medium ml-4 transition-all duration-300 ease-out;
  }

  .nav-links {
    @apply flex items-center gap-2 !mt-0;
  }

  .nav-links a {
    @apply px-3 py-1 rounded-full underline-offset-4 transition-all;
    @apply hover:bg-stone-100 hover:shadow-inner hover:shadow-stone-300 hover:underline;
  }

  .nav-links a.active {
    @apply bg-paper-dark text-white shadow-md;
  }

  .nav-fade {
    @apply w-full h-8 bg-gradient-to-t from-paper-base to-transparent rotate-180;
  }
</style>
