<style>
    .profile-frame--svg {
        @apply absolute w-full max-w-[85%] h-full;
        @apply flex justify-center items-center;
        @apply pointer-events-none mix-blend-overlay;
        @apply top-[10%] md:top-[7%] xl:top-[10%];
        @apply left-[15%] md:left-[12%] xl:left-[14%];
    }

    /* Make SVG responsive and maintain aspect ratio */
    .profile-frame--svg svg {
        @apply w-full h-full;
        @apply absolute top-1/2 left-1/2;
        transform: translate(-50%, -50%);
        aspect-ratio: 719/745;
        object-fit: contain;
    }

    /* Animation styles remain the same */
    .profile-frame--svg path {
        stroke-dasharray: 1500;
        stroke-dashoffset: 1500;
        animation: draw 2s ease forwards;
    }

    /* Stagger animations remain the same */
    .profile-frame--svg path:nth-child(2) {
        animation-delay: 0.2s;
    }
    .profile-frame--svg path:nth-child(3) {
        animation-delay: 0.4s;
    }
    .profile-frame--svg path:nth-child(4) {
        animation-delay: 0.6s;
    }
    .profile-frame--svg path:nth-child(5) {
        animation-delay: 0.8s;
    }

    @keyframes draw {
        to {
            stroke-dashoffset: 0;
        }
    }
</style>

<script>
    // Calculate proper stroke-dasharray values for each path
    document.addEventListener("DOMContentLoaded", () => {
        const paths = document.querySelectorAll(".profile-frame--svg path");

        paths.forEach((path, index) => {
            const length = (path as SVGGeometryElement).getTotalLength();
            (path as HTMLElement).style.strokeDasharray = `${length}`;
            (path as HTMLElement).style.strokeDashoffset = `${length}`;

            // Update animation delay based on path length
            (path as HTMLElement).style.animationDelay = `${index * 0.1}s`;

            // Add hover animation
            (path as HTMLElement).addEventListener("mouseenter", () => {
                (path as HTMLElement).style.strokeWidth = "6";
            });

            (path as HTMLElement).addEventListener("mouseleave", () => {
                (path as HTMLElement).style.strokeWidth = "5";
            });
        });
    });

    // Optional: Add scroll-based animation trigger
    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    entry.target.classList.add("animate-paths");
                }
            });
        },
        {
            threshold: 0.1,
            rootMargin: "50px",
        },
    );

    const svg = document.querySelector(".profile-frame--svg");
    if (svg) observer.observe(svg);
</script>

